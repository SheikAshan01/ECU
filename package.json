{
  "name": "react-test",
  "version": "0.1.0",
  "private": true,
  "description": "This project was bootstrapped with Create React App.",
  "main": "main.js",
  "homepage": "./",
  "scripts": {
    "start": "react-scripts start",            
    "electron-start": "electron-forge start",    
    "flask-backend": "python backend/app.py",
    "data-logger": "python backend/data_logger.py",
    "dev": "concurrently \"npm run flask-backend\" \"npm run data-logger\" \"npm start\"",
    "build": "react-scripts build",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "dependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^13.5.0",
    "child_process": "^1.0.2",
    "electron-squirrel-startup": "^1.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-scripts": "5.0.1",
    "recharts": "^2.15.3",
    "web-vitals": "^2.1.4"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.8.0",
    "@electron-forge/maker-deb": "^7.8.0",
    "@electron-forge/maker-rpm": "^7.8.0",
    "@electron-forge/maker-squirrel": "^7.8.0",
    "@electron-forge/maker-zip": "^7.8.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.8.0",
    "@electron-forge/plugin-fuses": "^7.8.0",
    "@electron/fuses": "^1.8.0",
    "concurrently": "^9.1.2",
    "electron": "^35.2.0"
  },
  "config": {
    "forge": {
      "packagerConfig": {
        "icon": "backend/MMW",             
        "extraFiles": [
          {
            "from": "backend",
            "to": "backend"
          }
        ]
      },
      "makers": [
        {
          "name": "@electron-forge/maker-squirrel",
          "config": {
            "name": "reacttest",
            "authors": "Your Name or Company",
            "description": "My React + Python desktop app",
            "version": "0.1.0"
          }
        },
        {
          "name": "@electron-forge/maker-zip",
          "platforms": [
            "darwin"
          ]
        },
        {
          "name": "@electron-forge/maker-deb",
          "config": {}
        },
        {
          "name": "@electron-forge/maker-rpm",
          "config": {}
        }
      ]
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
